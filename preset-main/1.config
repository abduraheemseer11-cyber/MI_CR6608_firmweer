# Target
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6608=y

# LuCI & Themes (الواجهة والثيم الأزرق)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# Wireless (دعم تشفير WPA3 لشبكاتك)
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# Network (تعطيل الجدار الناري و IPv6 لتوفير المساحة)
# CONFIG_PACKAGE_luci-app-firewall is not set
CONFIG_PACKAGE_ipv6=n
CONFIG_PACKAGE_odhcp6c=n
CONFIG_PACKAGE_dnsmasq-full=n
CONFIG_PACKAGE_dnsmasq=y

# Removed Heavy Packages (تم حذف البرامج الثقيلة لضمان حجم صغير)
# CONFIG_PACKAGE_luci-app-qbittorrent_dynamic is not set
# CONFIG_PACKAGE_luci-app-qbittorrent-simple_dynamic is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-webadmin is not set
# CONFIG_PACKAGE_luci-app-nlbwmon is not set
# CONFIG_PACKAGE_luci-app-arpbind is not set
# CONFIG_PACKAGE_luci-app-autoreboot is not set
# CONFIG_PACKAGE_luci-app-nat6-helper is not set
# CONFIG_PACKAGE_luci-theme-neobird is not set
# CONFIG_PACKAGE_luci-app-ramfree is not set
